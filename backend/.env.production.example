# PM Internship Scheme - Production Environment Template (Placeholders Only)
# COPY TO SERVER ENVIRONMENT VARIABLES / SECRETS MANAGER BEFORE DEPLOYMENT

ENVIRONMENT=production

# High-entropy 256-bit cryptographic secret key (>= 32 characters)
SECRET_KEY=YOUR_CRYPTOGRAPHICALLY_SECURE_PRODUCTION_SECRET_KEY_HERE_MIN_32_CHARS

# Managed PostgreSQL database URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://prod_user:prod_password@prod-db-host.internal:5432/pm_internships_prod

# Allowed production CORS origins (comma-separated, NO wildcards)
CORS_ORIGINS=https://your-production-app.vercel.app,https://pminternship.mca.gov.in

# OAuth Public Google Client ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Production Observability
PROMETHEUS_METRICS_ENABLED=true
